-- Power BI DAX Measures
-- Proyecto 2: Dashboard Power BI
-- Estas medidas se usaran sobre las vistas SQL preparadas en el Proyecto 1.

-- KPIs principales
Total Students =
DISTINCTCOUNT ( 'vw_student_segments'[student_id] )

Grade Average =
AVERAGE ( 'vw_student_segments'[grades] )

At-Risk Students =
CALCULATE (
    DISTINCTCOUNT ( 'vw_student_segments'[student_id] ),
    'vw_student_segments'[grades] < 60
)

At-Risk % =
DIVIDE (
    [At-Risk Students],
    [Total Students]
)

Excellent Students =
CALCULATE (
    DISTINCTCOUNT ( 'vw_student_segments'[student_id] ),
    'vw_student_segments'[grades] >= 90
)

Excellent % =
DIVIDE (
    [Excellent Students],
    [Total Students]
)

-- Promedios de comportamiento
Average Gaming Hours =
AVERAGE ( 'vw_student_segments'[gaming_hours] )

Average Study Hours =
AVERAGE ( 'vw_student_segments'[study_hours] )

Average Sleep Hours =
AVERAGE ( 'vw_student_segments'[sleep_hours] )

Average Attendance =
AVERAGE ( 'vw_student_segments'[attendance] )

Average Addiction Score =
AVERAGE ( 'vw_student_segments'[addiction_score] )

Average Device Usage =
AVERAGE ( 'vw_student_segments'[device_usage] )

Average Reaction Time =
AVERAGE ( 'vw_student_segments'[reaction_time_ms] )

-- Medidas reutilizables para graficos por banda o segmento
Gaming Band Avg Grade =
[Grade Average]

Study Band Avg Grade =
[Grade Average]

Sleep Band Avg Grade =
[Grade Average]

Risk Segment Students =
[Total Students]

Performance Band Students =
[Total Students]
